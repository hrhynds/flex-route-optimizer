# Copy to .env and fill in. Never commit the real one.

# The domain customers reach. Every link texted out is built on this.
APP_DOMAIN=app.yourdomain.com

# Signs and protects sessions. Generate with:  openssl rand -base64 48
APP_SECRET=

# Optional: connect Twilio and texts send themselves. Leave blank and every
# message is prepared for you to send from your own phone instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
