{
  "name": "graceful-auto-detailing",
  "version": "1.0.0",
  "private": true,
  "description": "Admin dashboard and customer portal for Graceful Auto Detailing.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "owner": "node --disable-warning=ExperimentalWarning scripts/create-owner.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.js'",
    "reset-password": "node --disable-warning=ExperimentalWarning scripts/reset-password.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js",
    "setup-code": "node --disable-warning=ExperimentalWarning scripts/setup-code.js"
  },
  "dependencies": {}
}
